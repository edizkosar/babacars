# ── Temel ──────────────────────────────────────────────
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Veritabanı (opsiyonel) ─────────────────────────────
