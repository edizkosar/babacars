# ── Temel ──────────────────────────────────────────────
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1

# ── Veritabanı (opsiyonel) ─────────────────────────────
# Boş bırakılırsa SQLite kullanılır. Postgres için:
# DATABASE_URL=postgres://kullanici:sifre@host:5432/veritabani
# DATABASE_SSL=True

# ── E-posta (Gmail SMTP) ───────────────────────────────
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=BabaCars <noreply@babacars.com>

# ── Google ile Giriş (django-allauth) ──────────────────
# Google Cloud Console → OAuth 2.0 Client ID oluştur, buraya yaz
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Kalıcı Medya (Cloudinary) ──────────────────────────
# cloudinary.com → Dashboard → "API Environment variable" değerini yapıştır
# Boş bırakılırsa fotoğraflar yerel diske kaydedilir (ücretsiz host'ta silinir).
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── Production güvenlik (yalnızca DEBUG=False iken) ─────
# SECURE_SSL_REDIRECT=True
# CSRF_TRUSTED_ORIGINS=https://siteniz.onrender.com
